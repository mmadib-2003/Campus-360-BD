# apps/web/.env.example — copy to .env.local and fill in for your deployment.
#
# ── Auth mode ────────────────────────────────────────────────────────────────
# 'demo'    → Track B: the verify screen shows the Demo OTP panel (deterministic
#             6-digit code per email) and /signin shows the DevSignInPanel.
# 'production' → Track A: OTPs are delivered over custom SMTP (Resend/SendGrid/
#             Mailtrap configured in Supabase Dashboard → Authentication → SMTP).
NEXT_PUBLIC_AUTH_MODE=demo

# Public salt for the deterministic demo OTP (SHA-256(salt:email)). Demo mode
# only — never use a secret value here that guards anything real.
NEXT_PUBLIC_DEMO_OTP_SALT=campus360-demo-otp-salt

# ── Supabase (leave unset for the local demo store) ──────────────────────────
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Track A — custom SMTP delivery via Resend ────────────────────────────────
# (Mirrors Supabase Dashboard → Authentication → SMTP Settings.)
# RESEND_API_KEY=re_...
# EMAIL_FROM_ADDRESS=Campus360 BD <no-reply@yourdomain.com>

# ── Secrets ──────────────────────────────────────────────────────────────────
# OTP_PEPPER_SECRET=change-me
# ANON_COMPLAINT_PEPPER=change-me

# apps/web/.env.example — copy to .env.local and fill in for your deployment.
#
# ── Auth mode ────────────────────────────────────────────────────────────────
# 'demo'       → Track B fallback ONLY: with no RESEND_API_KEY configured,
#                /api/auth/request-otp issues a deterministic per-email code and
#                the verify screen shows the Demo OTP panel (nothing is mailed).
# 'production' → Track A: real 6-digit CSPRNG OTP emailed through Gmail SMTP
#                (Nodemailer) in real time, hashed + TTL'd in verification_attempts.
# Setting GMAIL_USER + GMAIL_APP_PASSWORD always wins: real delivery is used even
# while this is still 'demo', and the Demo OTP panel stops receiving a code.
NEXT_PUBLIC_AUTH_MODE=production

# Public salt for the deterministic demo OTP (SHA-256(salt:email)). Demo mode
# only — never use a secret value here that guards anything real. Real codes are
# CSPRNG-generated (crypto) and carry a 5-minute TTL in verification_attempts.
NEXT_PUBLIC_DEMO_OTP_SALT=campus360-demo-otp-salt

# ── Supabase (leave unset for the local demo store) ──────────────────────────
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Track A — real-time OTP email via Nodemailer + Gmail SMTP ────────────────
# apps/web/lib/otp-email.ts builds a `service: 'gmail'` transport from these and
# mails the branded OTP itself (Supabase's default provider only mails team
# members, 2/hour — see docs/OTP_DIAGNOSIS.md). No verified domain is required,
# which is why this replaced the Resend API on a free plan.
# GMAIL_USER=campus360bd@gmail.com                       # the sending account
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx                 # app password (2FA on); never the account password; never NEXT_PUBLIC_*
# EMAIL_FROM_ADDRESS="Campus360 BD Verification <campus360bd@gmail.com>"  # display name only
# SUPPORT_EMAIL=campus360bd@gmail.com                    # shown in the email footer
#
# Optional: SMTP_POOL=1 (long-running servers only), SMTP_MAX_CONNECTIONS,
# SMTP_MAX_MESSAGES, SMTP_TIMEOUT_MS, SMTP_SEND_TIMEOUT_MS.
#
# Putting the same credentials into Supabase Dashboard → Authentication → SMTP
# Settings also lets password-reset / magic-link mail leave the team inbox.
#
# Personal Gmail accounts cap out around 500 recipients/day — plan the account
# accordingly (docs/OTP_DIAGNOSIS.md §6).

# ── Secrets ──────────────────────────────────────────────────────────────────
# HMAC key for verification_attempts.otp_hash. Mandatory whenever real OTPs are
# issued: /api/auth/request-otp returns 503 AUTH_CONFIG_UNAVAILABLE in
# production if this is unset (no default pepper is allowed in prod).
# OTP_PEPPER_SECRET=change-me
# ANON_COMPLAINT_PEPPER=change-me

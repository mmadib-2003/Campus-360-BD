# apps/web/.env.example — copy to .env.local and fill in for your deployment.
#
# ── Auth mode ────────────────────────────────────────────────────────────────
# 'demo'       → Track B fallback ONLY: with no RESEND_API_KEY configured,
#                /api/auth/request-otp issues a deterministic per-email code and
#                the verify screen shows the Demo OTP panel (nothing is mailed).
# 'production' → Track A: real 6-digit CSPRNG OTP emailed through the Resend API
#                in real time, hashed + TTL'd in verification_attempts.
# Setting RESEND_API_KEY always wins: real delivery is used even while this is
# still 'demo', and the Demo OTP panel stops receiving a code.
NEXT_PUBLIC_AUTH_MODE=production

# Public salt for the deterministic demo OTP (SHA-256(salt:email)). Demo mode
# only — never use a secret value here that guards anything real. Real codes are
# CSPRNG-generated (crypto) and carry a 5-minute TTL in verification_attempts.
NEXT_PUBLIC_DEMO_OTP_SALT=campus360-demo-otp-salt

# ── Supabase (leave unset for the local demo store) ──────────────────────────
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Track A — real-time OTP email via the Resend API ─────────────────────────
# apps/web/lib/otp-email.ts builds the SDK client from RESEND_API_KEY and posts
# the branded OTP email directly (Supabase's default provider only mails team
# members, 2/hour — see docs/OTP_DIAGNOSIS.md).
# RESEND_API_KEY=re_...                                  # server-only, never NEXT_PUBLIC_*
# EMAIL_FROM_ADDRESS="Campus360 BD Verification <no-reply@yourdomain.com>"  # verified sender domain (SPF/DKIM)
# RESEND_FROM_EMAIL=                                     # optional alias for EMAIL_FROM_ADDRESS
# SUPPORT_EMAIL=support@yourdomain.com                   # shown in the email footer
#
# Keeping Supabase Dashboard → Authentication → SMTP on the same Resend
# credentials also lets password-reset / magic-link mail leave the team inbox.

# ── Secrets ──────────────────────────────────────────────────────────────────
# HMAC key for verification_attempts.otp_hash. Mandatory whenever real OTPs are
# issued: /api/auth/request-otp returns 503 AUTH_CONFIG_UNAVAILABLE in
# production if this is unset (no default pepper is allowed in prod).
# OTP_PEPPER_SECRET=change-me
# ANON_COMPLAINT_PEPPER=change-me

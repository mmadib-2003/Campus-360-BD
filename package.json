{
  "name": "campus360-bd",
  "version": "1.0.0",
  "private": true,
  "description": "Campus360 BD \u2014 Multi-University Verified Super-App Platform (Web + Mobile + Supabase)",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @campus360/web dev",
    "dev:mobile": "pnpm --filter @campus360/mobile start",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @campus360/web test:e2e",
    "test:e2e:web": "pnpm --filter @campus360/web test:e2e",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "test:modules": "vitest run apps/web/__tests__"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
